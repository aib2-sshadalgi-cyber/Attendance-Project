PORT=5000
NODE_ENV=development

# Supabase Postgres transaction pooler (IPv4-friendly). Project Settings → Database → Connection string (Transaction pooler).
# URL-encode special characters in the password (e.g. @ → %40).
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DB_POOL_MAX=5

# Optional: only if you use backend/src/config/supabase.js (Storage, etc.)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Face match: lower = stricter (typical 0.5-0.6 for face-api)
FACE_MATCH_THRESHOLD=0.55

# Set to true only for local demos without camera matching (NOT for production)
DISABLE_FACE_VERIFY=false
