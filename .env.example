## Copy backend template for local apps
# Backend (copy to backend/.env) — see backend/.env.example for DATABASE_URL (Supabase pooler)
PORT=5000
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
FACE_MATCH_THRESHOLD=0.55
DISABLE_FACE_VERIFY=false

# Frontend (copy to frontend/.env when API is hosted elsewhere)
VITE_API_URL=
